---
import '../styles/global.css';
import UnderConstruction from '../components/UnderConstruction.astro';
const isProduction = import.meta.env.PROD;
const {title='Sonu Kizhakkepura | Materials Chemistry',description='Materials chemistry, surface and interface science, biomaterials, microfluidics and scientific notes.'}=Astro.props;
const pageTitle = isProduction ? 'Under Construction | Sonu Kizhakkepura' : title;
const pageDescription = isProduction
  ? 'A refreshed portfolio for Sonu Kizhakkepura is in progress. Get in touch by email.'
  : description;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content={pageDescription}><link rel="canonical" href={Astro.url}><title>{pageTitle}</title></head><body>
{isProduction ? <UnderConstruction /> : <>
<header class="site-header"><div class="container nav"><a class="logo" href="/">Sonu Kizhakkepura</a><nav class="nav-links"><a href="/#about">About</a><a href="/#expertise">Expertise</a><a href="/#projects">Projects</a><a href="/notes/">Scientific Notes</a><a href="/#publications">Publications</a><a href="/#contact">Contact</a></nav></div></header>
<slot />
<footer><div class="container">© {new Date().getFullYear()} Sonu Kizhakkepura · sonukp.in</div></footer>
</>}
</body></html>
